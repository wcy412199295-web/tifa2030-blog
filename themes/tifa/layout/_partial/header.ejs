<%
  var cur = '/' + (page.path || '').replace(/index\.html$/, '');
  function isActive(u) {
    if (u === '/') return is_home() || cur.indexOf('/page/') === 0;
    return cur.indexOf(u) === 0;
  }
%>
<header class="site-header" id="siteHeader">
  <div class="wrap">
    <a class="brand" href="<%- url_for('/') %>" aria-label="Tifa2030 首页">
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4.5 12 11h8l8-6.5-1 13.5L16 28.5 5 18z"/>
        <path d="M7.5 9.5 10 12M24.5 9.5 22 12" stroke-width="1.6"/>
        <circle cx="12" cy="17" r="1.3" fill="currentColor" stroke="none"/>
        <circle cx="20" cy="17" r="1.3" fill="currentColor" stroke="none"/>
        <path d="M14 22.5h4l-2 2.5z" fill="currentColor" stroke="none"/>
      </svg>
      <span>Tifa<span class="dot">2030</span></span>
    </a>
    <nav class="nav" aria-label="主导航">
      <% theme.menu.forEach(function (m) { %>
      <a href="<%- url_for(m.url) %>" class="<%= isActive(m.url) ? 'is-active' : '' %>"><%= m.name %></a>
      <% }) %>
    </nav>
    <div class="tools">
      <button class="icon-btn search-btn" data-search-open aria-label="搜索">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>搜索</span><kbd>⌘K</kbd>
      </button>
      <button class="icon-btn theme-btn" id="themeBtn" aria-label="切换深浅色">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button class="icon-btn menu-btn" id="menuBtn" aria-label="打开菜单" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      </button>
    </div>
  </div>
</header>
<div class="drawer" id="drawer" aria-hidden="true">
  <div class="drawer-mask" data-drawer-close></div>
  <div class="drawer-panel">
    <div class="drawer-head">
      <b>Tifa<span style="color:var(--accent)">2030</span></b>
      <button class="icon-btn" data-drawer-close aria-label="关闭菜单"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </div>
    <% theme.menu.forEach(function (m) { %>
    <a href="<%- url_for(m.url) %>" class="<%= isActive(m.url) ? 'is-active' : '' %>"><%= m.name %></a>
    <% }) %>
  </div>
</div>
