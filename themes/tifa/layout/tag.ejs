<% var posts = page.posts.toArray(); var curTag = site.tags.findOne({ name: page.tag }); %>
<section class="page-head">
  <div class="wrap">
    <span class="kicker"><a href="<%- url_for('/tags/') %>">标签</a></span>
    <h1># <%= page.tag %></h1>
    <p><%= curTag ? curTag.length : posts.length %> 篇文章<% if (page.total > 1) { %> · 第 <%= page.current %> / <%= page.total %> 页<% } %></p>
  </div>
</section>
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="grid">
      <% posts.forEach(function (post) { %><%- partial('_partial/card', { post: post }) %><% }) %>
    </div>
    <%- partial('_partial/pager') %>
  </div>
</section>
